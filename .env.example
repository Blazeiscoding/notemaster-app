# Copy to `.env` and fill in. Never commit the filled-in file.

# --- Clerk authentication (required) -----------------------------------------
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Database (required for signed-in, server-backed notes) ------------------
# Any PostgreSQL connection string. Guest mode works without it.
DATABASE_URL=postgresql://user:password@host:5432/notemaster

# --- Note encryption (strongly recommended) ----------------------------------
# Note titles, bodies, tags, checklists and attachment metadata are encrypted
# at rest with AES-256-GCM using a key derived from this value. If it is unset,
# notes are stored as PLAINTEXT.
#
# Use at least 32 characters of high-entropy random data, e.g.
#   openssl rand -base64 32
#
# WARNING: changing or losing this value makes existing notes undecryptable.
# See scripts/backfill-encryption.ts for migrating previously plaintext notes.
NOTES_ENCRYPTION_KEY=

# --- ImageKit (required only for image attachments) --------------------------
# https://imagekit.io/dashboard -> Developer Options
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
